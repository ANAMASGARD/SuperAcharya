# Custom health check message
PING_MESSAGE=pong

# --- Neon Postgres (neon link + neon deploy, or neon env pull) ---
# Runtime and dev servers use the pooled URL. Migrations use the direct URL.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# NEON_BRANCH=production

# --- Better Auth (built into Agent-Native; do not add a separate /api/auth route) ---
# Production: set a 32+ char secret. Local dev can use auto dev account or BETTER_AUTH_SECRET in .env.local
# BETTER_AUTH_SECRET=
# Leave unset locally so the framework infers the request origin.
# Deployment: optionally set the canonical public HTTPS origin; never localhost.
# BETTER_AUTH_URL=https://your-app.example.com
# AUTH_DISABLED=true  # demos only — every request shares one user; never in production
# AGENT_NATIVE_DISABLE_AUTO_DEV_ACCOUNT=1  # required to test landing → sign-in → /home on localhost

# Email + password and magic link are enabled by default when outbound email is configured.

# The sign-in / sign-up screens live at /auth/sign-in and /auth/sign-up and show
# Google, Microsoft and Facebook buttons. A button whose provider has no credentials
# below tells the user that provider is not set up yet; adding the credentials
# and restarting is all that is needed to turn it on.

# Google ("Continue with Google" on /auth/sign-in)
# GOOGLE_SIGN_IN_CLIENT_ID=
# GOOGLE_SIGN_IN_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=            # legacy / provider OAuth fallback
# GOOGLE_CLIENT_SECRET=

# Facebook (https://developers.facebook.com/apps)
# Redirect: {your-origin}/_agent-native/auth/ba/callback/facebook
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# Microsoft Entra ID (Azure app registration)
# Redirect: {your-origin}/_agent-native/auth/ba/callback/microsoft
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=          # optional; defaults to multi-tenant "common" when omitted

# Google redirect (framework Google flow, not Better Auth):
#   {your-origin}/_agent-native/google/callback

# GitHub OAuth (no button on the sign-in screen; still enabled at the API level)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Discord OAuth (no button on the sign-in screen; still enabled at the API level)
# Redirect: {your-origin}/_agent-native/auth/ba/callback/discord
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# LinkedIn OAuth (no button on the sign-in screen; still enabled at the API level)
# Redirect: {your-origin}/_agent-native/auth/ba/callback/linkedin
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Gnani Prisma v3.0 speech transcription; server-only STT-enabled API key.
# Scoped keys in Settings take precedence. Restart pnpm dev after changing this.
GNANI_API_KEY=

# Server-only teacher providers; scoped Settings credentials take precedence.
OPENAI_API_KEY=
CLOCKED_API_KEY=
SARVAM_API_KEY=
TEACHER_OPENAI_MODEL=gpt-6-luna
SARVAM_TTS_SPEAKER=kalpit_en_edtech
SARVAM_TTS_PACE=1.25
# PostgreSQL checkpoint setup is explicit; see docs/teacher.md.
